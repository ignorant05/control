# Control API, Development Environment Example
# Copy this to .env and fill in real values for local development.
# In production, use Kubernetes Secrets + ConfigMaps (see k8s/ directory) or with helm (see deploy/ directory).

# Server
PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Database (local dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/control?sslmode=disable

# Redis (local dev)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT: GENERATE A STRONG SECRET FOR PRODUCTION!
# Use: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
JWT_EXPIRY=24h

# Features
ENABLE_WEBSOCKET=true
ENABLE_AUDIT=true
